<script>
  class SlideDeck {
    constructor() {
      this.slides = Array.from(document.querySelectorAll('.slide'));
      this.indicator = document.getElementById('slide-indicator');
      this.prevBtn = document.getElementById('prev-btn');
      this.nextBtn = document.getElementById('next-btn');
      this.progressBar = document.getElementById('progress');

      const savedSlide = parseInt(localStorage.getItem('active_slide_v6'), 10);
      this.currentIdx = (!isNaN(savedSlide) && savedSlide >= 0 && savedSlide < this.slides.length)
        ? savedSlide
        : 0;

      this.init();
    }

    init() {
      this.updateSlides();

      this.prevBtn.addEventListener('click', () => this.prev());
      this.nextBtn.addEventListener('click', () => this.next());

      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === ' ') {
          e.preventDefault();
          this.next();
        }
        if (e.key === 'ArrowLeft') this.prev();
      });

      let touchStartX = 0;
      let touchEndX = 0;

      document.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      document.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 50) this.next();
        if (touchEndX - touchStartX > 50) this.prev();
      }, { passive: true });
    }

    goTo(index) {
      if (index < 0 || index >= this.slides.length) return;
      this.currentIdx = index;
      this.updateSlides();
      localStorage.setItem('active_slide_v6', this.currentIdx);
    }

    next() {
      if (this.currentIdx < this.slides.length - 1) this.goTo(this.currentIdx + 1);
    }

    prev() {
      if (this.currentIdx > 0) this.goTo(this.currentIdx - 1);
    }

    updateSlides() {
      this.slides.forEach((slide, idx) => {
        slide.classList.toggle('active', idx === this.currentIdx);
      });

      this.indicator.textContent = `第 ${this.currentIdx + 1} 页 / 共 ${this.slides.length} 页`;
      this.prevBtn.classList.toggle('is-disabled', this.currentIdx === 0);
      this.nextBtn.classList.toggle('is-disabled', this.currentIdx === this.slides.length - 1);

      if (this.progressBar) {
        const percent = ((this.currentIdx + 1) / this.slides.length) * 100;
        this.progressBar.style.width = percent + '%';
      }
    }
  }

  function speakZH(text) {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'zh-CN';
      utterance.rate = 0.9;
      window.speechSynthesis.speak(utterance);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    window.deck = new SlideDeck();
  });
</script>
