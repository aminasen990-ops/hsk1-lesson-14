        <circle cx="89.5" cy="80.5" r="1.5" fill="#FFF"/>
        <circle cx="113.5" cy="80.5" r="1.5" fill="#FFF"/>
        <ellipse cx="100" cy="100" rx="4" ry="5" fill="#22252A"/>
      </g>

      <g id="face-warm">
        <path d="M 83 82 Q 88 78 93 82" stroke="#22252A" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path d="M 107 82 Q 112 78 117 82" stroke="#22252A" stroke-width="3" fill="none" stroke-linecap="round"/>
