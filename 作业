      <g id="hoodie-grey"><path d="M 45 135 Q 100 120 155 135 L 165 200 L 35 200 Z" fill="#6C727E"/></g>
      <g id="hoodie-terracotta"><path d="M 45 135 Q 100 120 155 135 L 165 200 L 35 200 Z" fill="#E05A47"/></g>

      <!-- ═══ ПЕРСОНАЖ 2: ОНА (архетип) ═══ -->
      <g id="woman-base">
        <rect x="85" y="110" width="30" height="25" fill="#F5D5C0" rx="5"/>
        <ellipse cx="100" cy="85" rx="30" ry="33" fill="#FCE0CC"/>
        <path d="M 68 88 C 60 70, 66 48, 82 42 C 92 32, 112 32, 122 42 C 138 48, 144 70, 136 88 C 140 100, 142 112, 138 118 C 132 112, 128 100, 126 92 C 122 82, 118 76, 110 74 C 100 70, 92 72, 86 78 C 82 84, 78 92, 74 100 C 72 108, 70 114, 66 118 C 60 112, 62 100, 68 88 Z" fill="#E8C77A"/>
