                collocHTML+=`<div class="arc-branch branch-${c.color||'blue'}"><span class="branch-word">${c.word}</span> — <span class="branch-meaning">${c.meaning}</span> <span class="branch-example">(${c.example})</span></div>`;
            });
            collocHTML+=`</div></div>`;
            
            // Мнемоника
            let mnemoHTML=`<div class="mnemo-block"><strong>🧠 Мнемотехника (NO_PHONETIC):</strong>`;
            if(item.mnemo.char2){
                mnemoHTML+=`<div class="part"><b>Иероглиф 1 (${item.mnemo.char1.form}):</b> ${item.mnemo.char1.visual}<br><i>Сложность:</i> ${item.mnemo.char1.difficulty}<br><i>Значение:</i> ${item.mnemo.char1.meaning}</div>`;
                mnemoHTML+=`<div class="part"><b>Иероглиф 2 (${item.mnemo.char2.form}):</b> ${item.mnemo.char2.visual}<br><i>Сложность:</i> ${item.mnemo.char2.difficulty}<br><i>Значение:</i> ${item.mnemo.char2.meaning}</div>`;
            } else if(item.mnemo.char3){
                mnemoHTML+=`<div class="part"><b>Иероглиф 1 (${item.mnemo.char1.form}):</b> ${item.mnemo.char1.visual}<br><i>Сложность:</i> ${item.mnemo.char1.difficulty}<br><i>Значение:</i> ${item.mnemo.char1.meaning}</div>`;
                mnemoHTML+=`<div class="part"><b>Иероглиф 2 (${item.mnemo.char2.form}):</b> ${item.mnemo.char2.visual}<br><i>Сложность:</i> ${item.mnemo.char2.difficulty}<br><i>Значение:</i> ${item.mnemo.char2.meaning}</div>`;
                mnemoHTML+=`<div class="part"><b>Иероглиф 3 (${item.mnemo.char3.form}):</b> ${item.mnemo.char3.visual}<br><i>Сложность:</i> ${item.mnemo.char3.difficulty}<br><i>Значение:</i> ${item.mnemo.char3.meaning}</div>`;
            } else {
                mnemoHTML+=`<div class="part"><b>Иероглиф (${item.mnemo.char1.form}):</b> ${item.mnemo.char1.visual}<br><i>Сложность:</i> ${item.mnemo.char1.difficulty}<br><i>Значение:</i> ${item.mnemo.char1.meaning}</div>`;
            }
            mnemoHTML+=`<div class="together">🔗 Как работают вместе: ${item.mnemo.together}</div><div class="anchor">${item.mnemo.anchor}</div>`;
            if(item.mnemo.warning) mnemoHTML+=`<div style="background:#fdf2f0;padding:8px;border-radius:8px;margin-top:8px;">${item.mnemo.warning}</div>`;
            if(item.sinonyms) mnemoHTML+=`${item.sinonyms}`;
            mnemoHTML+=`</div>`;
            
            // Ссылки
            let linksHTML = '';
            if (item.links && item.links.length > 0) {
                linksHTML = `<div class="video-link"><strong>📺 Видео по теме:</strong><br>${item.links[0]}<br><a href="${item.links[1]}" target="_blank">${item.links[1]}</a></div>`;
            }
            
            // Q&A блок
            let qaHTML = '';
            if (item.qa && item.qa.length > 0) {
                qaHTML = `<div class="qa-block">`;
                item.qa.forEach((q, qIdx) => {
                    qaHTML += `
                        <div class="qa-question">❓ ${q.question}</div>
                        <div class="qa-answer-area">
                            <input type="text" class="qa-input" id="qaInput_${idx}_${qIdx}" placeholder="Напишите ответ по-китайски..." autocomplete="off">
                            <button class="qa-check-btn" onclick="checkAnswer(${idx}, ${qIdx})">✅ Проверить</button>
                            <button class="qa-show-btn" onclick="showAnswer(${idx}, ${qIdx})">👀 Показать ответ</button>
                        </div>
                        <div class="qa-result" id="qaResult_${idx}_${qIdx}"></div>
                        <div class="qa-correct-answer" id="qaCorrect_${idx}_${qIdx}" data-answer="${q.answer}">
                            <strong>✅ Правильный ответ:</strong> ${q.answer}
                        </div>
                    `;
                });
                qaHTML += `</div>`;
            }
            
            card.innerHTML=`
                <div><span class="chinese">${item.word}</span><span class="pinyin">${pinyinHtml}</span></div>
                <div class="translation">${item.trans}</div>
                <div class="trace-canvas-container"><canvas class="trace-canvas" id="canvas_${idx}"></canvas>
                <div class="trace-actions"><button onclick="clearCanvas(${idx})">🧹 Очистить</button><button onclick="undoCanvas(${idx})">↩️ Отменить</button></div></div>
                ${mnemoHTML}${collocHTML}${linksHTML}${qaHTML}
                <div class="note-sticker"><div class="note-header"><span>📝 Мой конспект</span><span class="note-status" id="status_${noteKey}">${savedText?'🟢 Сохранено':'⚪ Не сохранено'}</span></div>
                <textarea id="textarea_${noteKey}" placeholder="Ваша заметка...">${savedText}</textarea>
                <div class="note-actions"><button class="btn-save" onclick="saveNote('${noteKey}')">💾 Сохранить</button><button class="btn-clear" onclick="clearNote('${noteKey}')">🗑️ Очистить</button></div></div>`;
            container.appendChild(card);
            initCanvas(idx);
        });
    }

    // ===== CANVAS =====
    function initCanvas(idx){
        const canvas=document.getElementById(`canvas_${idx}`); if(!canvas)return;
        const container=canvas.parentElement; canvas.width=container.clientWidth-10; canvas.height=150;
        const dpr=window.devicePixelRatio||1;
        if(dpr>1){ const w=canvas.width,h=canvas.height; canvas.width=w*dpr; canvas.height=h*dpr; canvas.style.width=w+'px'; canvas.style.height=h+'px'; const ctx=canvas.getContext('2d'); ctx.scale(dpr,dpr); }
        drawCanvasGrid(canvas);
        canvasStates[idx]={isDrawing:false,strokes:[],currentStroke:[]}; undoStates[idx]=[];
        const ctx=canvas.getContext('2d'); ctx.lineWidth=3; ctx.lineCap='round'; ctx.lineJoin='round'; ctx.strokeStyle='#1e4620';
        function getPos(e){ const r=canvas.getBoundingClientRect(); const cx=e.touches?e.touches[0].clientX:e.clientX; const cy=e.touches?e.touches[0].clientY:e.clientY; const sx=canvas.width/(r.width*(window.devicePixelRatio||1)); const sy=canvas.height/(r.height*(window.devicePixelRatio||1)); return {x:(cx-r.left)*sx,y:(cy-r.top)*sy}; }
        function start(e){ e.preventDefault(); const p=getPos(e); canvasStates[idx].isDrawing=true; canvasStates[idx].currentStroke=[p]; ctx.beginPath(); ctx.moveTo(p.x,p.y); }
        function draw(e){ e.preventDefault(); if(!canvasStates[idx].isDrawing)return; const p=getPos(e); canvasStates[idx].currentStroke.push(p); ctx.lineTo(p.x,p.y); ctx.stroke(); }
        function stop(){ if(canvasStates[idx].isDrawing){ canvasStates[idx].isDrawing=false; if(canvasStates[idx].currentStroke.length>0){ canvasStates[idx].strokes.push([...canvasStates[idx].currentStroke]); canvasStates[idx].currentStroke=[]; } } }
        canvas.onmousedown=start; canvas.onmousemove=draw; canvas.onmouseup=stop; canvas.onmouseleave=stop; canvas.ontouchstart=start; canvas.ontouchmove=draw; canvas.ontouchend=stop;
    }
    function drawCanvasGrid(canvas){ const ctx=canvas.getContext('2d'); const dpr=window.devicePixelRatio||1; const w=canvas.width/dpr,h=canvas.height/dpr; ctx.clearRect(0,0,w,h); ctx.strokeStyle='#f0e8dc'; ctx.lineWidth=0.5; for(let y=0;y<=h;y+=25){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();} for(let x=0;x<=w;x+=25){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();} }
    window.clearCanvas=function(idx){ const c=document.getElementById(`canvas_${idx}`); if(!c)return; if(!undoStates[idx])undoStates[idx]=[]; undoStates[idx].push(JSON.stringify(canvasStates[idx]?.strokes||[])); canvasStates[idx].strokes=[]; canvasStates[idx].currentStroke=[]; drawCanvasGrid(c); showToast('🧹 Очищено'); };
    window.undoCanvas=function(idx){ const c=document.getElementById(`canvas_${idx}`); if(!c||!undoStates[idx]||undoStates[idx].length===0){showToast('Нечего отменять','');return;} const prev=undoStates[idx].pop(); canvasStates[idx].strokes=JSON.parse(prev); drawCanvasGrid(c); const ctx=c.getContext('2d'); const dpr=window.devicePixelRatio||1; ctx.scale(dpr,dpr); ctx.lineWidth=3; ctx.lineCap='round'; ctx.lineJoin='round'; ctx.strokeStyle='#1e4620'; canvasStates[idx].strokes.forEach(s=>{ if(s.length>0){ctx.beginPath();ctx.moveTo(s[0].x,s[0].y);s.forEach(p=>ctx.lineTo(p.x,p.y));ctx.stroke();}}); showToast('↩️ Отменено'); };

    // ===== ПОИСК =====
    window.searchVocab=function(q){ q=q.trim().toLowerCase(); document.querySelectorAll('.word-card').forEach(c=>{ const t=c.textContent.toLowerCase(); if(!q||t.includes(q)){c.style.display=''; if(q)c.classList.add('highlight'); else c.classList.remove('highlight');} else {c.style.display='none'; c.classList.remove('highlight');} }); };
    window.clearSearch=function(){ document.getElementById('vocabSearch').value=''; searchVocab(''); };

    // ===== ГРАММАТИКА =====
    function renderGrammar(){ document.getElementById('grammarContainer').innerHTML=grammarData.map(g=>`<div class="grammar-card"><h3>${g.title}</h3><p>${g.desc}</p><ul>${g.examples.map(e=>`<li>${e}</li>`).join('')}</ul></div>`).join(''); }

    // ===== ДИАЛОГИ =====
    function renderDialogs(){
        const container=document.getElementById('dialogsContainer'); container.innerHTML='';
        dialogsData.forEach((dialog,dIdx)=>{
            const card=document.createElement('div'); card.className='dialog-card';
            let html=`<strong>${dialog.title}</strong><div class="dialog-controls">
                <button class="active" id="pinyinBtn_${dIdx}" onclick="toggleDialogPinyin(${dIdx})">🔤 Пиньинь</button>
                <button class="active" id="transBtn_${dIdx}" onclick="toggleDialogTrans(${dIdx})">🌐 Перевод</button></div>`;
            dialog.lines.forEach((line,lIdx)=>{
                const noteKey=getNoteKey('dialog',`${dIdx}_${lIdx}`); const notes=loadNotes(); const savedText=notes[noteKey]||'';
                const noteId=`dialogNote_${dIdx}_${lIdx}`;
                const pinyinHtml=line.pinyin.split(/(\d+)/).map(p=>/^\d$/.test(p)?`<span class="tone">${p}</span>`:p).join(' ');
                html+=`
                <div class="dialog-line"><span class="speaker">${line.speaker}</span><span>${line.chn}</span>
                ${line.note?`<button class="btn-toggle-note" onclick="toggleDialogNote('${noteId}')">💡 Разбор</button>`:''}</div>
                <div class="dialog-pinyin" id="dialogPinyin_${dIdx}_${lIdx}">${pinyinHtml}</div>
                <div class="dialog-trans" id="dialogTrans_${dIdx}_${lIdx}">${line.trans}</div>
                ${line.note?`<div class="dialog-note-body" id="${noteId}">${line.note}</div>`:''}
                <button class="btn-toggle-note" onclick="toggleNoteSticker('${noteKey}')" style="margin:6px 0;font-size:0.75rem;">📝 Заметка</button>
                <div class="note-sticker" id="noteSticker_${noteKey}" style="display:none;">
                    <div class="note-header"><span>📝 Заметка к реплике</span><span class="note-status" id="status_${noteKey}">${savedText?'🟢 Сохранено':'⚪ Не сохранено'}</span></div>
                    <textarea id="textarea_${noteKey}" placeholder="Ваш перевод...">${savedText}</textarea>
                    <div class="note-actions"><button class="btn-save" onclick="saveNote('${noteKey}')">💾 Сохранить</button><button class="btn-clear" onclick="clearNote('${noteKey}')">🗑️ Очистить</button></div>
                </div>`;
            });
            card.innerHTML=html; container.appendChild(card);
        });
    }
    window.toggleDialogNote=function(id){ document.getElementById(id).classList.toggle('open'); };
    window.toggleNoteSticker=function(key){ const el=document.getElementById(`noteSticker_${key}`); if(el) el.style.display = el.style.display==='none' ? 'block' : 'none'; };
    window.toggleDialogPinyin=function(dIdx){
        const els=document.querySelectorAll(`[id^="dialogPinyin_${dIdx}_"]`);
        els.forEach(el=>el.classList.toggle('hidden'));
        const btn=document.getElementById(`pinyinBtn_${dIdx}`);
        btn.classList.toggle('active');
        showToast(els[0]?.classList.contains('hidden')?'Пиньинь скрыт':'Пиньинь показан');
    };
    window.toggleDialogTrans=function(dIdx){
        const els=document.querySelectorAll(`[id^="dialogTrans_${dIdx}_"]`);
        els.forEach(el=>el.classList.toggle('hidden'));
        const btn=document.getElementById(`transBtn_${dIdx}`);
        btn.classList.toggle('active');
        showToast(els[0]?.classList.contains('hidden')?'Перевод скрыт':'Перевод показан');
    };

    // ===== ЧТЕНИЕ =====
    function renderReading(){
        const container=document.getElementById('readingContainer'); container.innerHTML='';
        readingData.forEach((item,rIdx)=>{
            const card=document.createElement('div'); card.className='reading-card';
            const pinyinHtml=item.pinyin.split(/(\d+)/).map(p=>/^\d$/.test(p)?`<span class="tone">${p}</span>`:p).join(' ');
            let html=`<strong>${item.title}</strong>
            <div class="reading-controls">
                <button class="active" id="readPinyinBtn_${rIdx}" onclick="toggleReadingPinyin(${rIdx})">🔤 Пиньинь</button>
                <button class="active" id="readTransBtn_${rIdx}" onclick="toggleReadingTrans(${rIdx})">🌐 Перевод</button>
            </div>
            <div class="reading-text-chinese">${item.chn}</div>
            <div class="reading-text-pinyin" id="readingPinyin_${rIdx}">${pinyinHtml}</div>
            <div class="reading-text-trans" id="readingTrans_${rIdx}">${item.trans}</div>`;
            item.questions.forEach((q,qIdx)=>{ const aid=`readingAns_${rIdx}_${qIdx}`; html+=`<div class="reading-question">❓ ${q.q}</div><button class="small-btn" onclick="toggleAnswer('${aid}')">👀 Ответ</button><div class="reading-answer" id="${aid}">✅ ${q.a}</div>`; });
            const noteKey=getNoteKey('reading',rIdx); const notes=loadNotes(); const savedText=notes[noteKey]||'';
            html+=`<div class="note-sticker"><div class="note-header"><span>📝 Заметки</span><span class="note-status" id="status_${noteKey}">${savedText?'🟢 Сохранено':'⚪ Не сохранено'}</span></div><textarea id="textarea_${noteKey}">${savedText}</textarea><div class="note-actions"><button class="btn-save" onclick="saveNote('${noteKey}')">💾</button><button class="btn-clear" onclick="clearNote('${noteKey}')">🗑️</button></div></div>`;
            card.innerHTML=html; container.appendChild(card);
        });
    }
    window.toggleAnswer=function(id){ document.getElementById(id).classList.toggle('show'); };
    window.toggleReadingPinyin=function(idx){
        const el=document.getElementById(`readingPinyin_${idx}`);
        el.classList.toggle('hidden');
        const btn=document.getElementById(`readPinyinBtn_${idx}`);
        btn.classList.toggle('active');
        showToast(el.classList.contains('hidden')?'Пиньинь скрыт':'Пиньинь показан');
    };
    window.toggleReadingTrans=function(idx){
        const el=document.getElementById(`readingTrans_${idx}`);
        el.classList.toggle('hidden');
        const btn=document.getElementById(`readTransBtn_${idx}`);
        btn.classList.toggle('active');
        showToast(el.classList.contains('hidden')?'Перевод скрыт':'Перевод показан');
    };

    // ===== ПРАКТИКА =====
    function renderPractice(){
        const container=document.getElementById('practiceContainer'); container.innerHTML='';
        practiceData.forEach((topic,tIdx)=>{
            const card=document.createElement('div'); card.className='practice-topic';
            let html=`<h3>${topic.title}</h3>`;
            topic.questions.forEach(q=>{ html+=`<div class="question-box">💬 ${q}</div>`; });
            if(topic.highlights) html+=`<div class="grammar-highlight"><strong>📌 Лексика и грамматика:</strong><br>${topic.highlights.join('<br>')}</div>`;
            const noteKey=getNoteKey('practice',tIdx); const notes=loadNotes(); const savedText=notes[noteKey]||'';
            html+=`<div class="note-sticker"><div class="note-header"><span>📝 Ответы</span><span class="note-status" id="status_${noteKey}">${savedText?'🟢 Сохранено':'⚪ Не сохранено'}</span></div><textarea id="textarea_${noteKey}">${savedText}</textarea><div class="note-actions"><button class="btn-save" onclick="saveNote('${noteKey}')">💾</button><button class="btn-clear" onclick="clearNote('${noteKey}')">🗑️</button></div></div>`;
            card.innerHTML=html; container.appendChild(card);
        });
    }

    // ===== ИЕРОГЛИФЫ =====
    function renderCharOrbs(){
        const c=document.getElementById('charOrbContainer'); c.innerHTML='';
        currentChars.forEach((char,idx)=>{
            const orb=document.createElement('div');
            orb.className=`char-orb orb-${(idx%12)+1}`;
            const sizes=['small','medium','large'];
            orb.classList.add(sizes[Math.floor(Math.random()*3)]);
            orb.textContent=charVisible?char:'?';
            orb.title=char;
            orb.onclick=function(){
                if(!charVisible){ showToast('Сначала покажите иероглифы!'); return; }
                if(char===targetChar){ orb.classList.add('found'); showToast(`✅ Правильно: ${char}`); }
                else { showToast(`❌ Это: ${char}`); }
            };
            c.appendChild(orb);
        });
    }
    function spinCharWheel(){
        targetChar=allChars[Math.floor(Math.random()*allChars.length)];
        const resultEl=document.getElementById('charWheelResult');
        resultEl.textContent=`Найдите: ${targetChar}`;
        resultEl.style.fontSize='2rem';
        showToast(`🎯 Найдите: ${targetChar}`);
    }
    function toggleCharVisibility(){
        charVisible=!charVisible;
        document.querySelectorAll('.char-orb').forEach(orb=>{ orb.textContent=charVisible?orb.title:'?'; });
        const btn=event.target; btn.textContent=charVisible?'👁️ Скрыть':'👁️ Показать';
        showToast(charVisible?'Показаны':'Скрыты');
    }
    function shuffleChars(){
        currentChars=[...allChars].sort(()=>Math.random()-0.5);
        renderCharOrbs();
        showToast('🔀 Перемешано!');
    }

    // ===== РАНДОМАЙЗЕР =====
    window.spinPracticeWheel=function(){
        const names=['黎分析师','业务分析师','策略专家'];
        const topics=practiceData.map(t=>t.title);
        const allQ=practiceData.flatMap(t=>t.questions);
        const sn=[...names].sort(()=>Math.random()-0.5);
        const rt=topics[Math.floor(Math.random()*topics.length)];
        const rq=allQ[Math.floor(Math.random()*allQ.length)];
        document.getElementById('practiceWheelResult').textContent=`${sn[0]} → ${sn[1]} | ${rt} | ${rq}`;
    };

    // ===== ГЛОБАЛЬНЫЕ =====
    window.saveNote=function(key){ const ta=document.getElementById(`textarea_${key}`); if(!ta)return; const n=loadNotes(); n[key]=ta.value; saveNotes(n); const st=document.getElementById(`status_${key}`); if(st){st.textContent=ta.value?'🟢 Сохранено':'⚪ Не сохранено'; st.className='note-status'+(ta.value?' saved':'');} showToast('✅ Сохранено!'); };
    window.clearNote=function(key){ const ta=document.getElementById(`textarea_${key}`); if(!ta)return; ta.value=''; const n=loadNotes(); delete n[key]; saveNotes(n); const st=document.getElementById(`status_${key}`); if(st){st.textContent='⚪ Не сохранено'; st.className='note-status';} showToast('🗑️ Очищено'); };
    window.exportData=function(){
        const n=loadNotes(); let txt='HSK 1 · Урок 15 · Заметки (v8)\n========================================\n\n';
        for(const[k,v]of Object.entries(n)){ txt+=`📌 ${k}:\n${v}\n\n`; }
        txt+='========================================\nЭкспортировано: '+new Date().toLocaleString()+'\n';
        const blob=new Blob([txt],{type:'text/plain;charset=utf-8'}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download='HSK15_Notes_v8.txt'; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url); showToast('📤 Экспортировано!');
    };

    // ===== ВКЛАДКИ =====
    document.querySelectorAll('.tab-btn').forEach(btn=>{
        btn.addEventListener('click',function(){
            document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
            this.classList.add('active');
            document.querySelectorAll('.section').forEach(s=>s.classList.remove('active-section'));
            const target=document.getElementById(this.dataset.tab);
            if(target)target.classList.add('active-section');
            if(this.dataset.tab==='chars')renderCharOrbs();
        });
    });

    // ===== ИНИЦИАЛИЗАЦИЯ =====
    renderVocab(); renderGrammar(); renderDialogs(); renderReading(); renderPractice();
    currentChars=[...allChars]; renderCharOrbs();
})();
</script>
</body>
</html>
