        let isCorrect = false;
        for (const kw of keywords) {
            if (userAnswer.includes(kw)) {
                isCorrect = true;
                break;
            }
        }
        
        if (isCorrect || userAnswer === correctAnswer) {
            result.textContent = '✅ Правильно!';
            result.className = 'qa-result success';
            input.className = 'qa-input correct';
