document.getElementById('cardModal').addEventListener('click', e => { if (e.target === document.getElementById('cardModal')) closeModal(); });
document.getElementById('closeAddBtn').addEventListener('click', closeAddModal);
document.getElementById('addModal').addEventListener('click', e => { if (e.target === document.getElementById('addModal')) closeAddModal(); });
document.getElementById('addBtn').addEventListener('click', openAddModal);
