let cards = [];
const STORAGE_KEY = 'hsk6_19cards_fixed_final';
let pinyinVisible = true;
let transVisible = true;
let searchQuery = '';
let currentModalId = null;
let isEditing = false;
let editingCard = null;

function loadCards() {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
        try {
            cards = JSON.parse(saved);
            if (!Array.isArray(cards) || cards.length === 0) cards = [...defaultCards];
        } catch(e) { cards = [...defaultCards]; }
    } else { cards = [...defaultCards]; }
}
function saveCards() { localStorage.setItem(STORAGE_KEY, JSON.stringify(cards)); }
function resetCards() {
    if (confirm('Сбросить все карточки к исходным?')) {
        cards = [...defaultCards];
        saveCards();
        renderAll();
        closeModal();
    }
}

function renderAll() {
    renderTicker();
    renderGrid();
}
function renderTicker() {
    const ticker = document.getElementById('ticker');
    if (!ticker) return;
    if (cards.length === 0) { ticker.innerHTML = ''; return; }
    const words = cards.map(c => `${c.emoji || '📘'} ${c.word}`).join(' · ');
    ticker.innerHTML = `<span>${words} ·&nbsp;</span><span>${words} ·&nbsp;</span>`;
}
function renderGrid() {
    const grid = document.getElementById('cardsGrid');
    const noResults = document.getElementById('noResults');
    if (!grid) return;
    const filtered = cards.filter(card => {
        if (!searchQuery.trim()) return true;
        const q = searchQuery.trim().toLowerCase();
        return (card.word + ' ' + card.pinyin + ' ' + card.translation).toLowerCase().includes(q);
    });
    if (filtered.length === 0) {
        grid.innerHTML = '';
        noResults.style.display = 'block';
        return;
    }
    noResults.style.display = 'none';
    grid.innerHTML = filtered.map(card => `
        <div class="card-item" data-id="${card.id}">
            <button class="card-delete" data-id="${card.id}">✕</button>
            <div class="card-emoji">${card.emoji || '📘'}</div>
            <div class="card-word">${card.word}</div>
            ${pinyinVisible ? `<div class="card-pinyin">${card.pinyin || ''}</div>` : ''}
            ${transVisible ? `<div class="card-translation">${card.translation || ''}</div>` : ''}
        </div>
    `).join('');
    document.querySelectorAll('.card-item').forEach(el => {
        el.addEventListener('click', (e) => {
            if (e.target.classList.contains('card-delete')) return;
            openModal(el.dataset.id);
        });
    });
    document.querySelectorAll('.card-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (confirm('Удалить карточку?')) {
                cards = cards.filter(c => c.id !== btn.dataset.id);
                saveCards();
                renderAll();
            }
        });
    });
}

function openModal(id) {
    const card = cards.find(c => c.id === id);
    if (!card) return;
    currentModalId = id;
    isEditing = false;
    editingCard = null;
    updateModal(card);
    document.getElementById('cardModal').classList.add('active');
}
function closeModal() {
    document.getElementById('cardModal').classList.remove('active');
    currentModalId = null;
    isEditing = false;
    editingCard = null;
}
function updateModal(card) {
    const container = document.getElementById('modalContent');
    if (!container) return;
    if (isEditing && editingCard) {
        renderEditForm(container, editingCard);
        return;
    }
    container.innerHTML = `
        <div class="modal-header">
            <div class="modal-emoji">${card.emoji || '📘'}</div>
            <div class="modal-word">${card.word}</div>
            <div class="modal-pinyin">${pinyinVisible ? card.pinyin : '🔒 пиньинь скрыт'}</div>
            <div class="modal-translation">${transVisible ? card.translation : '🔒 перевод скрыт'}</div>
        </div>
        ${card.persona ? `
        <div class="modal-section">
            <div class="modal-section-title">👤 Персонаж</div>
            <div class="modal-section-body">${card.persona}</div>
        </div>` : ''}
        ${card.anchor ? `
        <div class="modal-section">
            <div class="modal-section-title">🪝 Бытовой якорь</div>
            <div class="modal-section-body">${card.anchor}</div>
        </div>` : ''}
        <div class="modal-section">
            <div class="modal-section-title">👁️ Мнемоника</div>
            <div class="mnemonic-block">
                ${(card.mnemonics || []).map(m => `<div class="mnemonic-part">${m}</div>`).join('')}
                ${card.workTogether ? `<div style="margin-top:8px;font-weight:600;">${card.workTogether}</div>` : ''}
                ${card.fullImage ? `<div style="margin-top:8px;font-style:italic;">${card.fullImage}</div>` : ''}
            </div>
        </div>
        ${card.dialogue && (card.dialogue[0] || card.dialogue[1]) ? `
        <div class="modal-section">
            <div class="modal-section-title">💬 Живой диалог</div>
            <div class="modal-section-body">
                ${card.dialogue[0] ? `<div class="dialogue-a">🅰 ${card.dialogue[0]}</div>` : ''}
                ${card.dialogue[1] ? `<div class="dialogue-b">🅱 ${card.dialogue[1]}</div>` : ''}
            </div>
        </div>` : ''}
        ${card.collocations && card.collocations.length > 0 ? `
        <div class="modal-section">
            <div class="modal-section-title">🔗 Коллокации</div>
            <div class="collocations-cloud">
                ${card.collocations.map((c, idx) => {
                    const cls = idx === 0 ? 'hsk' : idx === 1 ? 'business' : 'media';
                    return `<div class="collocation-item ${cls}"><span class="collocation-level">${c.level}</span><span class="collocation-word">${c.items}</span><span class="collocation-example">${c.example || ''}</span></div>`;
                }).join('')}
            </div>
        </div>` : ''}
        ${card.polyglotText ? `
        <div class="modal-section">
            <div class="modal-section-title">🎯 Полигон</div>
            <div class="modal-section-body">
                <div class="polyglot-text">${highlightCollocations(card.polyglotText, card.collocations)}</div>
                <div class="polyglot-translation">${card.polyglotTranslation || ''}</div>
            </div>
        </div>` : ''}
        <div class="modal-canvas-wrap">
            <div class="modal-section-title">✏️ Прописи</div>
            <canvas id="modalCanvas" width="600" height="120"></canvas>
            <div class="modal-canvas-actions">
                <button id="modalUndo">↩️</button>
                <button id="modalRedo">↪️</button>
                <button id="modalClear">🗑️</button>
            </div>
        </div>
        <div class="modal-actions">
            <button class="modal-btn secondary" id="editBtn">✏️ Редактировать</button>
            <button class="modal-btn secondary" id="closeBtn">✕ Закрыть</button>
        </div>
    `;
    document.getElementById('editBtn')?.addEventListener('click', () => {
        isEditing = true;
        editingCard = JSON.parse(JSON.stringify(card));
        updateModal(card);
    });
    document.getElementById('closeBtn')?.addEventListener('click', closeModal);
    initModalCanvas();
}

function highlightCollocations(text, collocations) {
    if (!text) return text;
    let result = text;
    (collocations || []).forEach(c => {
        if (!c.items) return;
        const key = c.items.split('—')[0].trim();
        if (key && key.length > 0) {
            result = result.replace(new RegExp(key, 'g'), `<span class="highlight-collocation">${key}</span>`);
        }
    });
    return result;
}

function initModalCanvas() {
    const canvas = document.getElementById('modalCanvas');
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width || 600;
    canvas.height = 120;
    const ctx = canvas.getContext('2d');
    let drawing = false;
    let strokeHistory = [];
    let redoHistory = [];
    ctx.lineWidth = 3;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#2a2a2a';
    function getPos(e) {
        const r = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: clientX - r.left, y: clientY - r.top };
    }
    canvas.onmousedown = (e) => {
        drawing = true;
        const pos = getPos(e);
        ctx.beginPath();
        ctx.moveTo(pos.x, pos.y);
        strokeHistory.push([{ x: pos.x, y: pos.y }]);
        redoHistory = [];
    };
    canvas.onmousemove = (e) => {
        if (!drawing) return;
        const pos = getPos(e);
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();
        strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
    };
    canvas.onmouseup = () => { drawing = false; };
    canvas.onmouseleave = () => { drawing = false; };
    canvas.ontouchstart = (e) => {
        e.preventDefault();
        drawing = true;
        const pos = getPos(e);
        ctx.beginPath();
        ctx.moveTo(pos.x, pos.y);
        strokeHistory.push([{ x: pos.x, y: pos.y }]);
        redoHistory = [];
    };
    canvas.ontouchmove = (e) => {
        e.preventDefault();
        if (!drawing) return;
        const pos = getPos(e);
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();
        strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
    };
    canvas.ontouchend = () => { drawing = false; };

    function redraw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        strokeHistory.forEach(stroke => {
            if (stroke.length < 2) return;
            ctx.beginPath();
            ctx.moveTo(stroke[0].x, stroke[0].y);
            for (let i = 1; i < stroke.length; i++) { ctx.lineTo(stroke[i].x, stroke[i].y); }
            ctx.stroke();
        });
    }

    const undoBtn = document.getElementById('modalUndo');
    const redoBtn = document.getElementById('modalRedo');
    const clearBtn = document.getElementById('modalClear');
    if (undoBtn) undoBtn.onclick = () => { if (strokeHistory.length) { redoHistory.push(strokeHistory.pop()); redraw(); } };
    if (redoBtn) redoBtn.onclick = () => { if (redoHistory.length) { strokeHistory.push(redoHistory.pop()); redraw(); } };
    if (clearBtn) clearBtn.onclick = () => { strokeHistory = []; redoHistory = []; redraw(); };
}

function renderEditForm(container, card) {
    container.innerHTML = `
        <h2>✏️ Редактирование</h2>
        <div class="edit-form">
            <label>Слово</label><input type="text" id="efWord" value="${card.word || ''}">
            <label>Пиньинь</label><input type="text" id="efPinyin" value="${card.pinyin || ''}">
            <label>Перевод</label><input type="text" id="efTranslation" value="${card.translation || ''}">
            <label>Эмодзи</label><input type="text" id="efEmoji" value="${card.emoji || '📘'}">
            <label>Персонаж</label><textarea id="efPersona">${card.persona || ''}</textarea>
            <label>Якорь</label><textarea id="efAnchor">${card.anchor || ''}</textarea>
            <label>Мнемотехника (каждая с новой строки)</label><textarea id="efMnemonics">${(card.mnemonics || []).join('\n')}</textarea>
            <label>Как работают вместе</label><textarea id="efWorkTogether">${card.workTogether || ''}</textarea>
            <label>Картинка</label><textarea id="efFullImage">${card.fullImage || ''}</textarea>
            <label>Диалог А</label><textarea id="efDialA">${(card.dialogue && card.dialogue[0]) || ''}</textarea>
            <label>Диалог Б</label><textarea id="efDialB">${(card.dialogue && card.dialogue[1]) || ''}</textarea>
            <label>Коллокация HSK</label><textarea id="efColloc1">${(card.collocations && card.collocations[0]) ? card.collocations[0].level + '|' + card.collocations[0].items + '|' + card.collocations[0].example : ''}</textarea>
            <label>Коллокация Быт</label><textarea id="efColloc2">${(card.collocations && card.collocations[1]) ? card.collocations[1].level + '|' + card.collocations[1].items + '|' + card.collocations[1].example : ''}</textarea>
            <label>Коллокация Медиа</label><textarea id="efColloc3">${(card.collocations && card.collocations[2]) ? card.collocations[2].level + '|' + card.collocations[2].items + '|' + card.collocations[2].example : ''}</textarea>
            <label>Полигон текст</label><textarea id="efPolyText">${card.polyglotText || ''}</textarea>
            <label>Полигон перевод</label><textarea id="efPolyTrans">${card.polyglotTranslation || ''}</textarea>
            <div class="edit-actions">
                <button class="modal-btn primary" id="saveEditBtn">💾 Сохранить</button>
                <button class="modal-btn danger" id="cancelEditBtn">↩️ Отмена</button>
            </div>
        </div>
    `;
    document.getElementById('saveEditBtn')?.addEventListener('click', () => {
        const get = (id) => document.getElementById(id)?.value.trim() || '';
        const collocations = [];
        const parseColloc = (val) => {
            if (!val) return null;
            const p = val.split('|').map(s => s.trim());
            return { level: p[0] || '', items: p[1] || '', example: p[2] || '' };
        };
        const c1 = parseColloc(get('efColloc1'));
        const c2 = parseColloc(get('efColloc2'));
        const c3 = parseColloc(get('efColloc3'));
        if (c1) collocations.push(c1);
        if (c2) collocations.push(c2);
        if (c3) collocations.push(c3);

        const updated = {
            ...editingCard,
            word: get('efWord'),
            pinyin: get('efPinyin'),
            translation: get('efTranslation'),
            emoji: get('efEmoji'),
            persona: get('efPersona'),
            anchor: get('efAnchor'),
            mnemonics: get('efMnemonics').split('\n').map(s => s.trim()).filter(Boolean),
            workTogether: get('efWorkTogether'),
            fullImage: get('efFullImage'),
            dialogue: [get('efDialA'), get('efDialB')],
            collocations: collocations,
            polyglotText: get('efPolyText'),
            polyglotTranslation: get('efPolyTrans')
        };

        const index = cards.findIndex(c => c.id === editingCard.id);
        if (index !== -1) {
            cards[index] = updated;
            saveCards();
            isEditing = false;
            editingCard = null;
            updateModal(updated);
            renderGrid();
        }
    });
    document.getElementById('cancelEditBtn')?.addEventListener('click', () => {
        isEditing = false;
        editingCard = null;
        const card = cards.find(c => c.id === currentModalId);
        if (card) updateModal(card);
    });
}

function openAddModal() {
    const container = document.getElementById('addContent');
    container.innerHTML = `
        <h2>➕ Добавление карточек</h2>
        <p style="margin-bottom:8px;font-size:0.85rem;">Вставьте текст карточек. Разделитель — <strong># Карточка по HSK-6:</strong> или <strong>---</strong></p>
        <textarea id="massTextarea" class="mass-textarea" placeholder="Вставьте текст карточки..."></textarea>
        <div class="modal-actions">
            <button class="modal-btn primary" id="massParseBtn">✨ Распознать все</button>
            <button class="modal-btn secondary" id="manualCreateBtn">📝 Вручную</button>
        </div>
    `;
    document.getElementById('massParseBtn').addEventListener('click', massParse);
    document.getElementById('manualCreateBtn').addEventListener('click', manualCreate);
    document.getElementById('addModal').classList.add('active');
}
function closeAddModal() { document.getElementById('addModal').classList.remove('active'); }

function massParse() {
    const text = document.getElementById('massTextarea').value.trim();
    if (!text) { alert('Вставьте текст.'); return; }
    const blocks = text.split(/(?:#\s*Карточка по HSK-6:|^---$|---)/gm).map(b => b.trim()).filter(Boolean);
    let created = 0;
    blocks.forEach(block => {
        const card = parseToCard(block);
        if (card.word) {
            card.id = 'card_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
            cards.push(card);
            created++;
        }
    });
    if (created === 0) { alert('Не удалось распознать ни одной карточки. Проверьте формат.'); return; }
    saveCards();
    renderAll();
    closeAddModal();
    alert(`✅ Создано карточек: ${created}`);
}

function manualCreate() {
    const blank = {
        id: 'card_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
        word: '新词', emoji: '📘', pinyin: 'xīn cí', translation: 'новое слово', category: 'bookish',
        persona: '', anchor: '', mnemonics: [], workTogether: '', fullImage: '',
        dialogue: ['', ''], collocations: [
            { level: '🎯 HSK', items: '', example: '' },
            { level: '🗣️ Быт', items: '', example: '' },
            { level: '🎥 Медиа', items: '', example: '' }
        ],
        polyglotText: '', polyglotTranslation: ''
    };
    cards.push(blank);
    saveCards();
    renderAll();
    closeAddModal();
    openModal(blank.id);
    isEditing = true;
    editingCard = JSON.parse(JSON.stringify(blank));
    updateModal(blank);
}

function parseToCard(text) {
    const card = {
        word: '', emoji: '📘', pinyin: '', translation: '', category: 'bookish',
        persona: '', anchor: '', mnemonics: [], workTogether: '', fullImage: '',
        dialogue: ['', ''], collocations: [
            { level: '🎯 HSK', items: '', example: '' },
            { level: '🗣️ Быт', items: '', example: '' },
            { level: '🎥 Медиа', items: '', example: '' }
        ],
        polyglotText: '', polyglotTranslation: ''
    };
    const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
    const mainLine = lines.find(l => l.includes('📌'));
    if (mainLine) {
        const clean = mainLine.replace('📌', '').trim();
        const match = clean.match(/([\u1F300-\u1F9FF\u2600-\u26FF\u2700-\u27BF])?\s*([\u4e00-\u9fff]+)\s*([a-zA-ZāáǎàēéěèīíǐìōóǒòūúǔùǖǘǚǜüÜĀÁǍÀĒÉĚÈĪÍǏÌŌÓǑÒŪÚǓÙǕǗǙǛ\s]+)\s*[\-\u2014\u2013]\s*(.+)/);
        if (match) {
            if (match[1]) card.emoji = match[1].trim();
            card.word = match[2].trim();
            card.pinyin = match[3].trim();
            card.translation = match[4].trim();
        }
    }
    for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if (line.includes('🎵')) card.rhythm = line.replace(/.*🎵[^:]*[:\s]*/, '').trim();
        else if (line.includes('📐')) card.type = line.replace(/.*📐[^:]*[:\s]*/, '').trim();
        else if (line.includes('🧩 Каркас')) card.frame = line.replace(/.*🧩 Каркас[:\s]*/, '').trim();
        else if (line.includes('🪝 Бытовой якорь')) card.anchor = line.replace(/.*🪝 Бытовой якорь[:\s]*/, '').trim();
        else if (line.includes('👁️ Визуальная мнемотехника')) {
            const mnemonics = [];
            let j = i + 1;
            while (j < lines.length) {
                const next = lines[j];
                if (next.includes('🧩 Как работают вместе') || next.includes('🖼️ Цельная картинка') || next.includes('💬')) break;
                if (next.startsWith('・') || next.startsWith('•') || next.startsWith('-')) {
                    mnemonics.push(next.replace(/^[・•\-\s]+/, '').trim());
                }
                j++;
            }
            if (mnemonics.length) card.mnemonics = mnemonics;
            i = j - 1;
        }
        else if (line.includes('🧩 Как работают вместе')) card.workTogether = line.replace(/.*🧩 Как работают вместе[:\s]*/, '').trim();
        else if (line.includes('🖼️ Цельная картинка')) card.fullImage = line.replace(/.*🖼️ Цельная картинка[:\s]*/, '').trim();
        else if (line.includes('💡 Фишка автора')) card.expertise = line.replace(/.*💡 Фишка автора[:\s]*/, '').trim();
        else if (line.includes('📱 Вайб')) card.socialVibe = line.replace(/.*📱 Вайб[^:]*[:\s]*/, '').trim();
        else if (line.includes('🧠 Инсайт эксперта')) card.expertInsight = line.replace(/.*🧠 Инсайт эксперта[:\s]*/, '').trim();
        else if (line.includes('🗣️ Речевая редукция')) card.reduction = line.replace(/.*🗣️ Речевая редукция[:\s]*/, '').trim();
        else if (line.includes('🅰')) card.dialogue[0] = line.replace(/.*🅰\s*/, '').trim();
        else if (line.includes('🅱')) card.dialogue[1] = line.replace(/.*🅱\s*/, '').trim();
        else if (line.includes('🎯 HSK 3.0')) {
            const rest = line.replace(/.*🎯 HSK 3.0[:\s]*/, '').trim();
            const parts = rest.split('|');
            if (parts.length >= 1) card.collocations[0].items = parts[0].trim();
            if (parts.length >= 2) card.collocations[0].example = parts[1].trim();
        }
        else if (line.includes('🗣️ Быт:')) {
            const rest = line.replace(/.*🗣️ Быт[:\s]*/, '').trim();
            const parts = rest.split('|');
            if (parts.length >= 1) card.collocations[1].items = parts[0].trim();
            if (parts.length >= 2) card.collocations[1].example = parts[1].trim();
        }
        else if (line.includes('🎥 Медиа/СМИ')) {
            const rest = line.replace(/.*🎥 Медиа\/СМИ[:\s]*/, '').trim();
            const parts = rest.split('|');
            if (parts.length >= 1) card.collocations[2].items = parts[0].trim();
            if (parts.length >= 2) card.collocations[2].example = parts[1].trim();
        }
        else if (line.includes('🎯 Полигон')) card.polyglotText = line.replace(/.*🎯 Полигон[:\s]*/, '').trim();
        else if (line.includes('Перевод:')) card.polyglotTranslation = line.replace(/.*Перевод[:\s]*/, '').trim();
    }
    if (card.expertise || card.socialVibe) {
        card.persona = (card.expertise ? card.expertise + ' ' : '') + (card.socialVibe ? card.socialVibe : '');
    }
    return card;
}

function exportData() {
    const blob = new Blob([JSON.stringify(cards, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'hsk6_19cards.json';
    a.click();
    URL.revokeObjectURL(url);
}
function importData(file) {
    const reader = new FileReader();
    reader.onload = (e) => {
        try {
            const data = JSON.parse(e.target.result);
            if (Array.isArray(data)) {
                cards = data;
                saveCards();
                renderAll();
                alert('✅ Импортировано карточек: ' + data.length);
            } else { alert('Неверный формат файла.'); }
        } catch (err) { alert('Ошибка парсинга JSON.'); }
    };
    reader.readAsText(file);
}

