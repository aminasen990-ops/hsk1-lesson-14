            --text: #2d2a22;
            --muted: #8a7a64;
            --gold: #b8914a;
            --gold-soft: #fdf9f0;
            --green: #2e7d32;
            --green-soft: #e8f5e9;
            --blue: #4a5b8c;
            --blue-soft: #eef1f7;
            --purple: #6a4c9c;
            --purple-soft: #f3e5f5;
            --cinnabar: #b5443c;
            --radius: 20px;
            --shadow: 0 4px 12px rgba(0,0,0,0.04);
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Segoe UI', Roboto, system-ui, sans-serif; background:var(--bg); color:var(--text); line-height:1.6; padding:16px; }
        .app { max-width:1200px; margin:0 auto; }
        h1 { color:var(--green); font-size:1.8rem; margin-bottom:0.3rem; }
        .subtitle { color:var(--muted); margin-bottom:1rem; }

        .ticker-wrapper { overflow:hidden; background:var(--surface); border-radius:30px; padding:8px 0; margin-bottom:20px; box-shadow:var(--shadow); border:1px solid var(--border); }
        .ticker { display:flex; gap:20px; white-space:nowrap; animation:tickerScroll 30s linear infinite; font-family:'Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif; font-size:1.1rem; color:var(--muted); }
        @keyframes tickerScroll { 0%{transform:translateX(0);} 100%{transform:translateX(-50%);} }
        .ticker span { display:inline-block; white-space:nowrap; }

        .toolbar { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:16px; }
        .btn { border:1px solid var(--border); background:var(--surface); padding:8px 16px; border-radius:30px; font-weight:600; font-size:0.8rem; cursor:pointer; font-family:inherit; color:var(--text); box-shadow:var(--shadow); }
        .btn:hover { background:var(--gold-soft); }
        .btn.active { background:var(--green); color:#fff; border-color:var(--green); }
        .btn.danger { color:var(--cinnabar); }

        .search-wrap { margin-bottom:16px; }
        .search-wrap input { width:100%; padding:12px 18px; border-radius:30px; border:1px solid var(--border); font-size:0.9rem; outline:none; font-family:inherit; }

        .cards-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(240px,1fr)); gap:16px; }
        .card-item { background:var(--surface); border-radius:var(--radius); padding:18px; cursor:pointer; box-shadow:var(--shadow); border:1px solid var(--border); position:relative; display:flex; flex-direction:column; gap:4px; }
        .card-item:hover { transform:translateY(-3px); box-shadow:0 8px 20px rgba(0,0,0,0.08); }
        .card-item::before { content:''; position:absolute; top:0; left:0; bottom:0; width:4px; border-radius:var(--radius) 0 0 var(--radius); background:var(--gold); }
        .card-emoji { font-size:1.8rem; }
        .card-word { font-family:'Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif; font-size:1.5rem; font-weight:700; }
        .card-pinyin { font-size:0.85rem; color:var(--muted); }
        .card-translation { font-size:0.8rem; color:var(--muted); font-style:italic; }
        .card-delete { position:absolute; top:10px; right:12px; background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--muted); }
        .card-delete:hover { color:var(--cinnabar); }

        .no-results { text-align:center; padding:30px; background:var(--surface); border-radius:var(--radius); color:var(--muted); }
        .add-btn { display:block; width:100%; max-width:400px; margin:20px auto 0; padding:12px; border-radius:30px; border:2px dashed #cfc6b4; background:none; font-weight:600; cursor:pointer; font-family:inherit; color:var(--text); }

        .modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(30,30,30,0.55); z-index:1000; justify-content:center; align-items:center; padding:20px 16px; }
        .modal.active { display:flex; }
        .modal-card { background:var(--bg); border-radius:var(--radius); max-width:800px; width:100%; max-height:90vh; overflow-y:auto; padding:24px; box-shadow:0 20px 40px rgba(0,0,0,0.15); position:relative; }
        .modal-close { position:absolute; top:14px; right:16px; background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--muted); }
        .modal-header { text-align:center; margin-bottom:20px; }
        .modal-emoji { font-size:2.8rem; }
        .modal-word { font-family:'Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif; font-size:2.4rem; font-weight:700; }
        .modal-pinyin { font-size:1rem; color:var(--muted); }
        .modal-translation { font-size:1.05rem; color:var(--muted); font-style:italic; }

        .modal-section { margin-bottom:20px; }
        .modal-section-title { font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--muted); margin-bottom:6px; }
        .modal-section-body { font-size:0.9rem; line-height:1.7; }

        .mnemonic-block { background:var(--green-soft); border-radius:16px; padding:16px; border:1px solid var(--green); margin-bottom:12px; }
        .mnemonic-part { margin:8px 0; padding-left:12px; border-left:4px solid var(--green); }

        .collocations-cloud { display:flex; flex-wrap:wrap; gap:10px; }
        .collocation-item { border-radius:16px; padding:10px 14px; flex:1 1 200px; }
        .collocation-item.hsk { background:var(--gold-soft); border:1px solid var(--gold); }
        .collocation-item.business { background:var(--blue-soft); border:1px solid var(--blue); }
        .collocation-item.media { background:var(--purple-soft); border:1px solid var(--purple); }
        .collocation-level { font-weight:700; font-size:0.75rem; display:block; margin-bottom:4px; }
        .collocation-item.hsk .collocation-level { color:var(--gold); }
        .collocation-item.business .collocation-level { color:var(--blue); }
        .collocation-item.media .collocation-level { color:var(--purple); }
        .collocation-word { font-weight:600; }
        .collocation-example { display:block; font-size:0.82rem; color:var(--muted); font-style:italic; margin-top:4px; }

        .highlight-collocation { background:var(--gold-soft); border:1px solid var(--gold); border-radius:4px; padding:0 2px; font-weight:600; }
        .dialogue-a,.dialogue-b { display:block; margin:4px 0; padding-left:16px; border-left:3px solid var(--green); font-size:0.88rem; }
        .dialogue-b { border-left-color:var(--gold); }
        .polyglot-text { background:#f4f0e8; padding:12px; border-radius:8px; font-size:0.9rem; }
        .polyglot-translation { margin-top:8px; font-style:italic; color:var(--muted); font-size:0.85rem; padding-left:16px; border-left:3px solid #d0c8b8; }

        .modal-canvas-wrap { background:var(--surface); border-radius:16px; padding:12px; margin-top:16px; }
        .modal-canvas-wrap canvas { width:100%; height:120px; border-radius:8px; border:1px solid var(--border); background:#fffefc; cursor:crosshair; }
        .modal-canvas-actions { display:flex; gap:8px; margin-top:8px; justify-content:center; }
        .modal-canvas-actions button { border:1px solid var(--border); background:var(--surface); padding:6px 14px; border-radius:20px; font-size:0.75rem; cursor:pointer; font-family:inherit; }

        .modal-actions { display:flex; gap:10px; margin-top:20px; justify-content:center; }
        .modal-btn { border:none; padding:8px 20px; border-radius:30px; font-size:0.78rem; font-weight:600; cursor:pointer; font-family:inherit; }
        .modal-btn.primary { background:var(--text); color:#fff; }
        .modal-btn.secondary { background:#eae5da; color:var(--text); }
        .modal-btn.danger { background:#fdf2f0; color:var(--cinnabar); }

        .mass-textarea { width:100%; min-height:200px; padding:14px; border-radius:12px; border:1px solid var(--border); font-family:inherit; font-size:0.88rem; resize:vertical; outline:none; }
        .edit-form label { display:block; font-size:0.75rem; font-weight:600; color:var(--muted); margin:12px 0 4px; }
        .edit-form input,.edit-form textarea { width:100%; padding:8px 12px; border-radius:8px; border:1px solid var(--border); font-size:0.88rem; font-family:inherit; background:var(--surface); outline:none; }
        .edit-form textarea { min-height:60px; resize:vertical; }
        .edit-actions { display:flex; gap:10px; margin-top:20px; justify-content:center; }
    </style>
</head>
