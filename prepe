        }

        // ===================== КАНВАС В МОДАЛКЕ =====================
        function initModalCanvas() {
            const canvas = document.getElementById('modalCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let drawing = false;
            let strokeHistory = [];
            let redoHistory = [];
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.strokeStyle = '#2a2a2a';
            function getPos(e) {
                const rect = canvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return { x: clientX - rect.left, y: clientY - rect.top };
            }
            canvas.addEventListener('mousedown', (e) => {
                drawing = true;
                const pos = getPos(e);
                ctx.beginPath();
                ctx.moveTo(pos.x, pos.y);
                strokeHistory.push([]);
                strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
                redoHistory = [];
            });
            canvas.addEventListener('mousemove', (e) => {
                if (!drawing) return;
                const pos = getPos(e);
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
                strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
            });
            canvas.addEventListener('mouseup', () => { drawing = false; });
            canvas.addEventListener('mouseleave', () => { drawing = false; });
            canvas.addEventListener('touchstart', (e) => {
                e.preventDefault();
                drawing = true;
                const pos = getPos(e);
                ctx.beginPath();
                ctx.moveTo(pos.x, pos.y);
                strokeHistory.push([]);
                strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
                redoHistory = [];
            });
            canvas.addEventListener('touchmove', (e) => {
                e.preventDefault();
                if (!drawing) return;
                const pos = getPos(e);
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
                strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
            });
            canvas.addEventListener('touchend', () => { drawing = false; });
            function redraw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                strokeHistory.forEach(stroke => {
                    if (stroke.length < 2) return;
                    ctx.beginPath();
                    ctx.moveTo(stroke[0].x, stroke[0].y);
                    for (let i = 1; i < stroke.length; i++) { ctx.lineTo(stroke[i].x, stroke[i].y); }
                    ctx.stroke();
                });
            }
            document.getElementById('modalUndo')?.addEventListener('click', () => {
                if (strokeHistory.length === 0) return;
                redoHistory.push(strokeHistory.pop());
                redraw();
            });
            document.getElementById('modalRedo')?.addEventListener('click', () => {
                if (redoHistory.length === 0) return;
                strokeHistory.push(redoHistory.pop());
                redraw();
            });
            document.getElementById('modalClear')?.addEventListener('click', () => {
                strokeHistory = [];
                redoHistory = [];
                redraw();
            });
        }

        // ===================== ПОДСВЕТКА =====================
        function highlightGlowChars(text, word) {
            if (!text || !word) return text;
            const chars = word.split('');
            let result = text;
            chars.forEach(ch => { if (ch && ch !== ' ') { result = result.replace(new RegExp(ch, 'g'), `<span class="glow-char">${ch}</span>`); } });
            return result;
        }
        function highlightTarget(text, word) {
            if (!text || !word) return text;
            return text.replace(new RegExp(word, 'g'), `<span class="highlight-target">${word}</span>`);
        }

        // ===================== РЕДАКТИРОВАНИЕ =====================
        function renderEditForm(container, card) {
            container.innerHTML = `
                <h2>✏️ Редактирование</h2>
                <div class="edit-form">
                    <label>Персонаж</label><textarea id="efPersona">${card.persona || ''}</textarea>
                    <label>Якорь</label><textarea id="efAnchor">${card.anchor || ''}</textarea>
                    <label>Мнемотехника (каждая с новой строки)</label><textarea id="efMnemonics">${(card.mnemonics || []).join('\n')}</textarea>
                    <label>Картинка</label><textarea id="efFullImage">${card.fullImage || ''}</textarea>
                    <label>Диалог А</label><textarea id="efDialA">${card.dialogue?.[0] || ''}</textarea>
                    <label>Диалог Б</label><textarea id="efDialB">${card.dialogue?.[1] || ''}</textarea>
                    <label>Коллокация HSK</label><textarea id="efColloc1">${card.collocations?.[0] ? card.collocations[0].level + '|' + card.collocations[0].items + '|' + card.collocations[0].example : ''}</textarea>
                    <label>Коллокация Быт</label><textarea id="efColloc2">${card.collocations?.[1] ? card.collocations[1].level + '|' + card.collocations[1].items + '|' + card.collocations[1].example : ''}</textarea>
                    <label>Коллокация Медиа</label><textarea id="efColloc3">${card.collocations?.[2] ? card.collocations[2].level + '|' + card.collocations[2].items + '|' + card.collocations[2].example : ''}</textarea>
                    <label>Полигон текст</label><textarea id="efPolyText">${card.polyglotText || ''}</textarea>
                    <label>Полигон перевод</label><textarea id="efPolyTrans">${card.polyglotTranslation || ''}</textarea>
                    <div class="edit-actions">
                        <button class="modal-btn primary" id="saveEditBtn">💾 Сохранить</button>
                        <button class="modal-btn danger" id="cancelEditBtn">↩️ Отмена</button>
                    </div>
                </div>
            `;
            document.getElementById('saveEditBtn')?.addEventListener('click', () => {
                const get = (id) => document.getElementById(id)?.value.trim() || '';
                const collocations = [];
                const parseColloc = (val) => { const p = val.split('|').map(s => s.trim()); if (p.length === 3) return { level: p[0], items: p[1], example: p[2] }; return null; };
                const c1 = parseColloc(get('efColloc1'));
                const c2 = parseColloc(get('efColloc2'));
                const c3 = parseColloc(get('efColloc3'));
                if (c1) collocations.push(c1);
                if (c2) collocations.push(c2);
                if (c3) collocations.push(c3);
                const updated = {
                    ...editingCard,
                    persona: get('efPersona'),
                    anchor: get('efAnchor'),
                    mnemonics: get('efMnemonics').split('\n').filter(s => s.trim()),
                    fullImage: get('efFullImage'),
                    dialogue: [get('efDialA'), get('efDialB')].filter(s => s),
                    collocations: collocations,
                    polyglotText: get('efPolyText'),
                    polyglotTranslation: get('efPolyTrans')
                };
                const index = cards.findIndex(c => c.id === editingCard.id);
                if (index !== -1) {
                    cards[index] = updated;
                    saveCards();
                    isEditing = false;
                    editingCard = null;
                    updateModal(updated);
                    renderGrid();
                }
            });
            document.getElementById('cancelEditBtn')?.addEventListener('click', () => {
                isEditing = false;
                editingCard = null;
                const card = cards.find(c => c.id === currentModalId);
                if (card) updateModal(card);
            });
        }

        // ===================== ДОБАВЛЕНИЕ =====================
        function openAddModal() {
            const container = document.getElementById('addContent');
            container.innerHTML = `
                <h2>➕ Добавление карточек</h2>
                <p style="margin-bottom:8px;font-size:0.85rem;">Вставьте текст одной или нескольких карточек. Разделитель — <strong>---</strong></p>
                <textarea id="massTextarea" class="mass-textarea" placeholder="📌 [ 词语 ] пиньинь — перевод&#10;👤 Персонаж: ...&#10;🪝 Якорь: ...&#10;---&#10;📌 [ 词语2 ] ..."></textarea>
                <div class="modal-actions">
                    <button class="modal-btn primary" id="massParseBtn">✨ Распознать все</button>
                    <button class="modal-btn secondary" id="manualCreateBtn">📝 Вручную</button>
                </div>
            `;
            document.getElementById('massParseBtn').addEventListener('click', massParse);
            document.getElementById('manualCreateBtn').addEventListener('click', manualCreate);
            document.getElementById('addModal').classList.add('active');
        }
        function closeAddModal() { document.getElementById('addModal').classList.remove('active'); }
        function massParse() {
            const text = document.getElementById('massTextarea').value.trim();
            if (!text) { alert('Вставьте текст.'); return; }
            const blocks = text.split(/---+/).map(b => b.trim()).filter(b => b);
            let created = 0;
            blocks.forEach(block => {
                const card = parseToCard(block);
                if (card.word) {
                    card.id = 'card_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
                    cards.push(card);
                    created++;
                }
            });
            if (created === 0) { alert('Не удалось распознать ни одной карточки.'); return; }
            saveCards();
            renderAll();
            closeAddModal();
            alert(`✅ Создано карточек: ${created}`);
        }
        function manualCreate() {
            const blank = {
                id: 'card_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                word: '', emoji: '📘', pinyin: '', translation: '', category: 'bookish',
                persona: '', anchor: '', mnemonics: [], fullImage: '',
                dialogue: ['', ''], collocations: [
                    { level: '🎯 HSK', items: '', example: '' },
                    { level: '🗣️ Быт', items: '', example: '' },
                    { level: '🎥 Медиа', items: '', example: '' }
                ],
                polyglotText: '', polyglotTranslation: ''
            };
            cards.push(blank);
            saveCards();
            renderAll();
            closeAddModal();
            openModal(blank.id);
            isEditing = true;
            editingCard = JSON.parse(JSON.stringify(blank));
            updateModal(blank);
        }
        function parseToCard(text) {
            const card = {
                word: '', emoji: '📘', pinyin: '', translation: '', category: 'bookish',
                persona: '', anchor: '', mnemonics: [], fullImage: '',
                dialogue: ['', ''], collocations: [
                    { level: '🎯 HSK', items: '', example: '' },
                    { level: '🗣️ Быт', items: '', example: '' },
                    { level: '🎥 Медиа', items: '', example: '' }
                ],
                polyglotText: '', polyglotTranslation: ''
            };
            const lines = text.split('\n').map(l => l.trim()).filter(l => l);
            const mainLine = lines.find(l => l.includes('[') && l.includes(']'));
            if (mainLine) {
                const match = mainLine.match(/\[([^\]]+)\]\s*([\w\sāáǎàēéěèīíǐìōóǒòūúǔùǖǘǚǜüÜĀÁǍÀĒÉĚÈĪÍǏÌŌÓǑÒŪÚǓÙǕǗǙǛ]+)\s*[—–\-–]\s*(.+)/);
                if (match) {
                    card.word = match[1].trim();
                    card.pinyin = match[2].trim();
                    card.translation = match[3].trim();
                }
            }
            for (let i = 0; i < lines.length; i++) {
                const line = lines[i];
                if (!line) continue;
                if (line.includes('Персонаж')) card.persona = line.replace(/.*Персонаж[:\s]*/, '').trim();
                else if (line.includes('Якорь')) card.anchor = line.replace(/.*Якорь[:\s]*/, '').trim();
                else if (line.includes('Мнемотехника')) {
                    const mnemonics = [];
                    let j = i + 1;
                    while (j < lines.length) {
                        const next = lines[j];
                        if (next.includes('Картинка') || next.includes('Как запомнить')) break;
                        if (next.startsWith('*') || next.startsWith('·') || next.startsWith('•') || next.startsWith('-')) {
                            mnemonics.push(next.replace(/^[*\s·•\-–]+/, '').trim());
                        }
                        j++;
                    }
                    if (mnemonics.length) card.mnemonics = mnemonics;
                    i = j - 1;
                }
                else if (line.includes('Картинка')) card.fullImage = line.replace(/.*Картинка[:\s]*/, '').trim();
                else if (line.includes('Диалог')) {
                    // Диалог может быть в двух строках
                }
                else if (line.includes('🅰') || line.startsWith('A:')) card.dialogue[0] = line.replace(/^🅰\s*/, '').trim();
                else if (line.includes('🅱') || line.startsWith('B:')) card.dialogue[1] = line.replace(/^🅱\s*/, '').trim();
                else if (line.includes('🎯 HSK')) {
                    const rest = line.replace(/.*🎯 HSK[:\s]*/, '').trim();
                    const parts = rest.split('|');
                    if (parts.length >= 1) card.collocations[0].items = parts[0].trim();
                    if (parts.length >= 2) card.collocations[0].example = parts[1].trim();
                }
                else if (line.includes('🗣️ Быт')) {
                    const rest = line.replace(/.*🗣️ Быт[:\s]*/, '').trim();
                    const parts = rest.split('|');
                    if (parts.length >= 1) card.collocations[1].items = parts[0].trim();
                    if (parts.length >= 2) card.collocations[1].example = parts[1].trim();
                }
                else if (line.includes('🎥 Медиа')) {
                    const rest = line.replace(/.*🎥 Медиа[:\s]*/, '').trim();
                    const parts = rest.split('|');
                    if (parts.length >= 1) card.collocations[2].items = parts[0].trim();
                    if (parts.length >= 2) card.collocations[2].example = parts[1].trim();
                }
                else if (line.includes('Текст:')) card.polyglotText = line.replace(/.*Текст[:\s]*/, '').trim();
                else if (line.includes('Перевод:')) card.polyglotTranslation = line.replace(/.*Перевод[:\s]*/, '').trim();
            }
            // Категория по типу
            const typeLower = (card.type || '').toLowerCase();
            if (typeLower.includes('идиома') || typeLower.includes('чэнъюй')) card.category = 'idiom';
            else if (typeLower.includes('разговорный')) card.category = 'colloquial';
            else card.category = 'bookish';
            return card;
        }

        // ===================== ЭКСПОРТ / ИМПОРТ =====================
        function exportData() {
            const blob = new Blob([JSON.stringify(cards, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'hsk6_living_words.json';
            a.click();
            URL.revokeObjectURL(url);
        }
        function importData(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const data = JSON.parse(e.target.result);
                    if (Array.isArray(data)) {
                        cards = data;
                        saveCards();
                        renderAll();
                        alert('✅ Импортировано: ' + data.length);
                    } else { alert('Неверный формат'); }
                } catch (err) { alert('Ошибка парсинга'); }
            };
            reader.readAsText(file);
        }

        // ===================== СОБЫТИЯ =====================
        document.getElementById('pinyinToggle').addEventListener('click', () => {
            pinyinVisible = !pinyinVisible;
            const btn = document.getElementById('pinyinToggle');
            btn.textContent = pinyinVisible ? '🔊 Пиньинь: Вкл' : '🔇 Пиньинь: Выкл';
            btn.classList.toggle('active', pinyinVisible);
